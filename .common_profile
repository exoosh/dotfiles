# Oliver's .common_profile (Bash/Zsh) - author: oliver@assarbad.net - may be freely copied, taken apart, put together and what not ...
# vim: set autoindent smartindent ts=4 sw=4 sts=4 filetype=sh:

# If not running interactively, don't do anything
[[ $- == *i* ]] || return

# Enforce the minimum supported shell versions: Bash >= 4.2, Zsh >= 5.3
if [[ -n "$BASH_VERSION" ]]; then
	if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2) )); then
		printf 'ERROR: .common_profile requires Bash >= 4.2 (found %s); aborting.\n' "$BASH_VERSION" >&2
		return
	fi
elif [[ -n "$ZSH_VERSION" ]]; then
	zsh_major=${ZSH_VERSION%%.*}
	zsh_minor=${ZSH_VERSION#*.}
	zsh_minor=${zsh_minor%%.*}
	if (( zsh_major < 5 || (zsh_major == 5 && zsh_minor < 3) )); then
		printf 'ERROR: .common_profile requires Zsh >= 5.3 (found %s); aborting.\n' "$ZSH_VERSION" >&2
		unset zsh_major zsh_minor
		return
	fi
	unset zsh_major zsh_minor
fi

# Some colors
declare -x cG="\e[1;32m" cR="\e[1;31m" cB="\e[1;34m" cW="\e[1;37m" cY="\e[1;33m" cG_="\e[0;32m" cR_="\e[0;31m" cB_="\e[0;34m" cW_="\e[0;37m" cY_="\e[0;33m" cZ="\e[0m"

function set_prompt_and_uid
{
	# Because UID is readonly we cannot use the real thing, so let's fake it below ;)
	local MYUID=$UID
	if [[ -v BASH_VERSION ]]; then
		if [[ $MYUID -eq 0 ]]; then
			declare -g PS1='${debian_chroot:+($debian_chroot)}\[\033[1;31m\]${SHLVL:+[$SHLVL] }\u\[\033[1;34m\]@\h\[\033[0m\]:\[\033[1;32m\]\w\[\033[0m\]\$ '
		else
			declare -g PS1='${debian_chroot:+($debian_chroot)}\[\033[01;34m\]${SHLVL:+[$SHLVL] }\u@\h\[\033[00m\]:\[\033[01;32m\]\w\[\033[00m\]\$ '
		fi
	elif [[ -v ZSH_VERSION ]]; then
		if (( EUID == 0 )); then
			declare -g PROMPT='%B%F{red}[%L] %n%f%F{blue}@%m%f%b:%F{green}%2~%f%# '
		else
			declare -g PROMPT='%B%F{blue}[%L] %n@%m%f%b:%F{green}%2~%f%# '
		fi
	fi
}

function add_home_bin
{
	if [[ -d "$HOME/bin" ]]; then
		if [[ ":$PATH:" != *":$HOME/bin:"* ]]; then
			PATH=$PATH:$HOME/bin
		fi
	fi
}

function add_cargo_bin
{
	if [[ -d "$HOME/.cargo/bin" ]]; then
		if [[ ":$PATH:" != *":$HOME/.cargo/bin:"* ]]; then
			PATH="$HOME/.cargo/bin:$PATH"
		fi
	fi
}

function set_remote_timeout
{
	# Superuser will get a timeout for the shell if it's a remote shell via SSH
	if [[ -n "$SSH_TTY" ]] && (( EUID == 0 )); then
		export TMOUT=1800
	fi
}

function clean_path_var
{
	# Remove empty entries
	export PATH=${PATH//::/:}
	if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || -n "$COMSPEC" ]]; then
		return
	fi

	if (( EUID == 0 )); then
		local NEWPATH='' LASTDIR='' dir
		local -a PATH_DIRS
		if [[ -v ZSH_VERSION ]]; then
			PATH_DIRS=("${path[@]}")
		else
			local IFS=:
			read -r -a PATH_DIRS <<< "$PATH"
		fi
		for dir in "${PATH_DIRS[@]}"; do
			[[ -z "$dir" || ! -d "$dir" ]] && continue
			LASTDIR=$dir
			if command ls -lLd "$dir" 2> /dev/null | command grep -q '^d.......w. '; then
				printf "\nDirectory %s in PATH was world-writable, removed it from PATH!!!\n" "$dir"
			elif [[ "$NEWPATH" != "$dir" ]]; then
				NEWPATH="$NEWPATH:$dir"
			fi
		done
		if [[ -n "$NEWPATH" && "${NEWPATH:1}" != "$PATH" ]]; then
			# Remove the leading colon and export this as the path
			declare -x PATH="${NEWPATH:1}"
			declare -p PATH
		fi
	fi
	export PATH
}

function set_shell_options
{
	if [[ -v BASH_VERSION ]]; then
		declare -g HISTCONTROL=erasedups:ignorespace
		declare -g HISTIGNORE="&:ls:ll:l:[bf]g:exit:clear:vim:env:cd:cdf:ccd:pushf:ducks:dux:psaux:lsb:lsbx:chorme"
		declare -g HISTFILESIZE=3000
		shopt -s autocd
		shopt -s checkwinsize
		shopt -s cdspell
		shopt -s dotglob
		shopt -s extglob
		if (( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 2) )); then
			shopt -s globskipdots
		fi
	elif [[ -v ZSH_VERSION ]]; then
		declare -g HISTFILE=~/.zsh_history
		declare -g HISTSIZE=3000
		declare -g SAVEHIST=3000
		declare -g HISTORY_IGNORE='(ls|ll|l|[bf]g|exit|clear|vim|env|cd|cdf|ccd|pushf|ducks|dux|psaux|lsb|lsbx|chorme)'
		setopt HIST_IGNORE_ALL_DUPS
		setopt HIST_IGNORE_SPACE
		setopt autocd
		setopt correct
		setopt globdots
		setopt extendedglob
	fi
}

function ls_aliases
{
	# Alias definitions for ls. Figure out the feature set ... (GNU vs. others)
	if [[ "$OSTYPE" =~ ^linux-gnu || "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
		if "${WHENCE_CMD[@]}" lsd > /dev/null 2>&1; then
			alias ls='lsd --group-dirs=first'
			alias ll='lsd --group-dirs=first --date "+%F %T" -l'
			alias l='lsd --group-dirs=first --date "+%F %T" -lA'
			alias tree='lsd --tree -l --date="+%F %T" --group-dirs=first --blocks=permission,size,date,name'
		else
			local -a MYLS_OPTS=(--color=auto --time-style=long-iso)
			if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || -n "$COMSPEC" ]]; then
				: # Git for Windows' coreutils always supports both flags
			else
				ls "${MYLS_OPTS[@]}" . > /dev/null 2>&1 || MYLS_OPTS=(--color=auto)
				ls "${MYLS_OPTS[@]}" . > /dev/null 2>&1 || MYLS_OPTS=()
			fi
			(( ${#MYLS_OPTS[@]} )) && export LS_OPTIONS="${MYLS_OPTS[*]}"
			alias ls="ls${LS_OPTIONS:+ $LS_OPTIONS}"
			alias ll="ls${LS_OPTIONS:+ $LS_OPTIONS} -l"
			alias l="ls${LS_OPTIONS:+ $LS_OPTIONS} -Al"
		fi
	else
		[[ "$(uname -s)" == "Darwin"  ]] && export CLICOLOR=
		[[ "$(uname -s)" == "FreeBSD" ]] && export CLICOLOR=
		alias ll='ls -l'
		alias l='ls -Al'
	fi
	# color hard links in cyan, but a little darker than soft links
	if [[ -e "/etc/debian_version" ]] && "${WHENCE_CMD[@]}" dircolors > /dev/null 2>&1; then
		# ls (from GNU coreutils) misbehaves in that it "succeeds" silently (exit code 0) although LS_COLORS is erroneous ... pain
		# ls: unrecognized prefix: mh
		# ls: unparsable value for LS_COLORS environment variable
		# However, this output doesn't seem to be shown when piping. How useless.
		local DIRCOLORS_OUTPUT MYLSCOLORS="ln=01;36"
		DIRCOLORS_OUTPUT=$(command dircolors)
		if [[ "$DIRCOLORS_OUTPUT" == *hl=* || "$DIRCOLORS_OUTPUT" == *mh=* ]]; then
			[[ "$DIRCOLORS_OUTPUT" == *hl=* ]] && MYLSCOLORS="$MYLSCOLORS:hl=00;36"
			[[ "$DIRCOLORS_OUTPUT" == *mh=* ]] && MYLSCOLORS="$MYLSCOLORS:mh=00;36"
			export LS_COLORS="$MYLSCOLORS"
		fi
	fi
}

function system_specific_aliases
{
	local i
	# Syntax: __create_abs_alias <name> <command>
	__create_abs_alias()
	{
		"${WHENCE_CMD[@]}" "$2" > /dev/null 2>&1 || return
		if [[ -n "$3" ]]; then
			alias $1="$3 $2"
		else
			alias $1="$2"
		fi
	}

	if [[ -e "/etc/debian_version" ]] || "${WHENCE_CMD[@]}" apt > /dev/null 2>&1; then
		# by NOT prepending command we defer to the sudo'd apt-alias created below
		alias search='apt search'
		alias show='apt show'
		alias upgrade='apt update && apt full-upgrade'
		alias apti='apt --no-install-recommends install'
		alias purge='apt purge'
		alias autopurge='apt autoremove --purge'
		alias autoremove='apt autoremove'
	fi
	if [[ -e "/etc/debian_version" ]] || "${WHENCE_CMD[@]}" dpkg > /dev/null 2>&1; then
		# by prepending command we invoke the actual binary, not the sudo'd dpkg-alias created below
		alias lp='command dpkg -l'
		alias lpg='command dpkg -l|grep -iE'
	fi
	if [[ -e "/etc/debian_version" ]]; then
		for i in debfoster:/usr/bin/debfoster deborphan:/usr/bin/deborphan; do
			__create_abs_alias ${i%%:*} "${i#*:}"
		done
		if (( EUID )); then
			for i in apt-get:/usr/bin/apt-get \
								aptitude:/usr/bin/aptitude \
								apt-mark:/usr/bin/apt-mark \
								apt:/usr/bin/apt \
								dpkg-reconfigure:/usr/sbin/dpkg-reconfigure \
								dpkg:/usr/bin/dpkg \
								service:/usr/sbin/service \
								lsof:/usr/bin/lsof \
								reboot:/usr/sbin/reboot \
								systemctl:/bin/systemctl \
								journalctl:/bin/journalctl
			do
				__create_abs_alias ${i%%:*} "${i#*:}" sudo
			done
		fi
	fi
	if [[ -e "/etc/redhat-release" ]] || "${WHENCE_CMD[@]}" yum > /dev/null 2>&1; then
		alias search='yum -C search'
		alias show='yum -C info'
		if (( EUID )) && "${WHENCE_CMD[@]}" sudo > /dev/null 2>&1; then
			alias upgrade='sudo yum update'
		else
			alias upgrade='yum update'
		fi
	fi
	if [[ -e "/etc/redhat-release" ]]; then
		if (( EUID )); then
			for i in ifconfig:/sbin/ifconfig \
								service:/sbin/service \
								lsof:/usr/sbin/lsof \
								reboot:/sbin/reboot \
								yum:/usr/bin/yum \
								iptables:/sbin/iptables
			do
				__create_abs_alias ${i%%:*} "${i#*:}" sudo
			done
		fi
	fi
	if "${WHENCE_CMD[@]}" pacman > /dev/null 2>&1; then
		# https://wiki.archlinux.org/title/Pacman/Rosetta
		alias apti='printf "You are not on Debian anymore\n"'
		alias search='pacman -Ss'
		alias show='pacman -Qi'
		if (( EUID )) && "${WHENCE_CMD[@]}" sudo > /dev/null 2>&1; then
			alias upgrade='sudo pacman -Syu'
			alias purge='sudo pacman -Rn'
			alias autopurge='sudo pacman -Rns'
			alias autoremove='sudo pacman -Rs'
		else
			alias upgrade='pacman -Syu'
			alias purge='pacman -Rn'
			alias autopurge='pacman -Rns'
			alias autoremove='pacman -Rs'
		fi
	fi
	if "${WHENCE_CMD[@]}" uname > /dev/null 2>&1 && [[ $(uname -s) == "FreeBSD" ]] && "${WHENCE_CMD[@]}" pkg > /dev/null 2>&1; then
		alias search='pkg search'
		alias show='pkg info'
		if [[ $UID -ne 0 ]]; then
			for i in pkg:/usr/sbin/pkg
			do
				__create_abs_alias ${i%%:*} "${i#*:}" sudo
			done
			alias upgrade='sudo pkg update && sudo pkg upgrade'
		else
			alias upgrade='pkg update && pkg upgrade'
		fi
	fi
	unset -f __create_abs_alias
}

function try_source_completions
{
	if "${WHENCE_CMD[@]}" "$1" > /dev/null 2>&1; then
		if command "$@" > /dev/null 2>&1; then
			# printf -- "Completions for %s:\n" "$1"
			case "$1.$SHELLKIND" in
				rustup.zsh)
					source <(command "$@") 2> /dev/null
					;;
				*)
					source <(command "$@")
					;;
			esac
		else
			printf -- "${cY}WARNING${cZ}: ${cW}%s${cZ} exists, but testing the command to source completions failed!\n" "$1"
		fi
	fi
}

function tool_aliases_and_init
{
	if "${WHENCE_CMD[@]}" ast-grep > /dev/null 2>&1; then
		alias sg="command ast-grep" # override "setgroup"
	fi
	if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || -n "$COMSPEC" ]]; then
		return
	fi
	local SHELLKIND=""
	[[ -v BASH_VERSION ]] && SHELLKIND="bash"
	[[ -v ZSH_VERSION ]] && SHELLKIND="zsh"
	if [[ -n "$SHELLKIND" ]]; then
		# Completion scripts below need compdef, which is only defined after compinit
		if [[ -v ZSH_VERSION ]] && ! whence -w compdef > /dev/null 2>&1; then
			autoload -Uz compinit
			compinit -i
		fi
		try_source_completions zoxide init $SHELLKIND
		try_source_completions rg --generate=complete-$SHELLKIND
		if (( EUID )); then
			try_source_completions rustup completions $SHELLKIND
			try_source_completions rustup completions $SHELLKIND cargo
		fi
		try_source_completions ast-grep completions $SHELLKIND
		try_source_completions sk --shell=$SHELLKIND
		try_source_completions uv generate-shell-completion $SHELLKIND
	fi
}

function convenience_aliases
{
	ls_aliases
	system_specific_aliases
	alias vf=cd
	# Convenience aliases
	alias ..='cd ..'
	alias ...='cd ../..'
	alias ....='cd ../../..'
	alias -- -='cd -'
	if "${WHENCE_CMD[@]}" mc > /dev/null 2>&1; then
		alias mc='mc -c'
	fi
	if "${WHENCE_CMD[@]}" helix > /dev/null 2>&1; then
		alias hx='helix'
	fi
	if "${WHENCE_CMD[@]}" ps > /dev/null 2>&1; then
		alias psaux='ps awwwux'
	fi
	if "${WHENCE_CMD[@]}" nano > /dev/null 2>&1; then
		alias nano='nano -w'
	fi
	if "${WHENCE_CMD[@]}" date > /dev/null 2>&1; then
		alias currdate='date +"%Y-%m-%d %H:%M:%S"'
	fi
	if "${WHENCE_CMD[@]}" lsblk > /dev/null 2>&1; then
		alias lsb="lsblk --exclude 7 -o NAME,MAJ:MIN,SIZE,RO,TYPE,FSTYPE,LABEL,MOUNTPOINT"
		alias lsbx="lsblk --exclude 7 -o NAME,MAJ:MIN,SIZE,RO,TYPE,FSTYPE,LABEL,MOUNTPOINT,PARTUUID,UUID"
	fi
	if "${WHENCE_CMD[@]}" df > /dev/null 2>&1; then
		alias df='df -x tmpfs -x squashfs -x overlay'
		if "${WHENCE_CMD[@]}" watch > /dev/null 2>&1; then
			alias wdf='watch -n 1 df -x tmpfs -x squashfs -x overlay'
		fi
	fi
	if "${WHENCE_CMD[@]}" chown > /dev/null 2>&1; then
		if [[ $UID -ne 0 ]]; then
			alias chorme='sudo /bin/chown -hR $USER:'
		else
			alias chorme='chown -hR $USER:'
		fi
	fi
	if "${WHENCE_CMD[@]}" rg > /dev/null 2>&1; then
		alias rgI="command rg --follow --no-ignore"
	fi
	export SYSTEMD_PAGER=''
	if "${WHENCE_CMD[@]}" systemctl > /dev/null 2>&1; then
		alias systemctl='systemctl --no-pager'
	fi
	if "${WHENCE_CMD[@]}" gpg > /dev/null 2>&1 && "${WHENCE_CMD[@]}" tty > /dev/null 2>&1 && "${WHENCE_CMD[@]}" git > /dev/null 2>&1; then
		alias git='env -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS -u XDG_CURRENT_DESKTOP GPG_TTY="$(tty)" PINENTRY_USER_DATA="USE_TTY=1" git'
	fi
	if "${WHENCE_CMD[@]}" ssh > /dev/null 2>&1; then
		alias ssh='ssh -t'
	fi
	if "${WHENCE_CMD[@]}" ssh > /dev/null 2>&1 && "${WHENCE_CMD[@]}" find > /dev/null 2>&1 && "${WHENCE_CMD[@]}" ls > /dev/null 2>&1; then
		alias list-ssh-sockets='find /tmp/ssh-* -name agent.\* -uid $EUID -exec ls -ahl {} \;'
	fi
	if "${WHENCE_CMD[@]}" ssh-keygen > /dev/null 2>&1 && "${WHENCE_CMD[@]}" test > /dev/null 2>&1; then
		alias ssh-list='for i in /etc/ssh/ssh_host_*.pub; do test -r $i && ssh-keygen -lf $i; done; for i in /etc/ssh/ssh_host_*.pub; do test -r $i && ssh-keygen -r $(hostname -s) -f $i; done'
	fi
	if "${WHENCE_CMD[@]}" ssh > /dev/null 2>&1; then
		alias SSH-insecure='ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
		alias SSH-very-insecure='ssh -o KexAlgorithms=+diffie-hellman-group1-sha1 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
	fi
	if "${WHENCE_CMD[@]}" scp > /dev/null 2>&1; then
		alias SCP-insecure='scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
		alias SCP-very-insecure='scp -o KexAlgorithms=+diffie-hellman-group1-sha1 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
	fi
	if "${WHENCE_CMD[@]}" ssh1 > /dev/null 2>&1; then
		alias SSH1-insecure='ssh1 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
		alias SSH1-very-insecure='ssh1 -o KexAlgorithms=+diffie-hellman-group1-sha1 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
	fi
	if "${WHENCE_CMD[@]}" scp1 > /dev/null 2>&1; then
		alias SCP1-insecure='scp1 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
		alias SCP1-very-insecure='scp1 -o KexAlgorithms=+diffie-hellman-group1-sha1 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
	fi
	if "${WHENCE_CMD[@]}" vim > /dev/null 2>&1; then
		if [[ -f "${SHELLRCDIR:-$HOME}/.vimrc" ]]; then
			local VIMRC="-u \"${SHELLRCDIR:-$HOME}/.vimrc\""
		fi
		local VIM_P_FLAG=""
		if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || -n "$COMSPEC" ]]; then
			VIM_P_FLAG="-p "
		elif "${WHENCE_CMD[@]}" grep > /dev/null 2>&1 && (command vim --help 2> /dev/null|grep -q '[[:space:]]*-p'); then
			VIM_P_FLAG="-p "
		fi
		local VIM_CMD="env HOME=\"${SHELLRCDIR:-$HOME}\" vim ${VIM_P_FLAG}-N -n -i NONE${VIMRC:+ $VIMRC}"
		alias vim="$VIM_CMD"
		export EDITOR=$("${WHENCE_CMD[@]}" vim)
		if [[ -t 1 ]] && "${WHENCE_CMD[@]}" git > /dev/null 2>&1; then
			export GIT_EDITOR="$VIM_CMD"
		fi
		if [[ -n "$EDITOR" ]]; then
			export VISUAL="$EDITOR"
		fi
	fi
	if "${WHENCE_CMD[@]}" visudo > /dev/null 2>&1; then
		if "${WHENCE_CMD[@]}" vim.nox > /dev/null 2>&1; then
			EDITOR=vim.nox
		elif "${WHENCE_CMD[@]}" vim > /dev/null 2>&1; then
			EDITOR=vim
		elif "${WHENCE_CMD[@]}" vi > /dev/null 2>&1; then
			EDITOR=vi
		fi
		if [[ -n "$EDITOR" ]]; then
			export EDITOR
			[[ $UID -eq 0 ]] || alias visudo="sudo env EDITOR=\"$EDITOR\" visudo"
		fi
	fi

	if [[ -v BASH_VERSION ]]; then
		alias sb="source ~/.bash_profile && cd -"
	elif [[ -v ZSH_VERSION ]]; then
		alias sz="source ~/.zshrc && cd -"
	fi

	if "${WHENCE_CMD[@]}" reset > /dev/null 2>&1 && "${WHENCE_CMD[@]}" stty > /dev/null 2>&1 && "${WHENCE_CMD[@]}" tput > /dev/null 2>&1; then
		alias tfix='reset; stty sane; tput rs1; clear; printf "\033c"'
	fi

	if "${WHENCE_CMD[@]}" colordiff > /dev/null 2>&1; then
		alias diff="command colordiff -u"
	else
		alias diff="command diff -u"
	fi

	if "${WHENCE_CMD[@]}" sort > /dev/null 2>&1 && "${WHENCE_CMD[@]}" env > /dev/null 2>&1; then
		alias e="env|sort -i"
	elif "${WHENCE_CMD[@]}" env > /dev/null 2>&1; then
		alias e="env"
	fi

	if "${WHENCE_CMD[@]}" sudo > /dev/null 2>&1; then
		# beroot so we feel at home when assuming super-user rights
		if (( EUID == 0 )); then
			if ! declare -pf beroot > /dev/null 2>&1; then
				function beroot
				{
					echo 'NOP'
				}
			fi
		else
			if ! declare -pf beroot > /dev/null 2>&1; then
				function beroot
				{
					if (( EUID )); then
						case "$SHELL" in
							bash | */bash | bash-static | */bash-static )
								sudo -u root /usr/bin/env SHELLRCDIR="${SHELLRCDIR:-$HOME}" "$SHELL" --rcfile "${SHELLRCDIR:-$HOME}/.bashrc"
								;;
							zsh | */zsh | zsh-static | */zsh-static )
								sudo -u root /usr/bin/env SHELLRCDIR="${SHELLRCDIR:-$HOME}" ZDOTDIR="${SHELLRCDIR:-$HOME}" "$SHELL" -i
								;;
						esac
					else
						echo 'NOP'
					fi
				}
			fi
		fi
	fi
	tool_aliases_and_init
}

function load_ssh_agent
{
	if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || -n "$COMSPEC" ]]; then
		return
	fi

	# Load the SSH agent and if it's loaded already, add the default identity
	if "${WHENCE_CMD[@]}" ssh-agent > /dev/null 2>&1; then
		local SSHAGENT SSHAGENTARGS TMUXEXE
		SSHAGENT=$("${WHENCE_CMD[@]}" ssh-agent)
		SSHAGENTARGS="-s"
		TMUXEXE="$("${WHENCE_CMD[@]}" tmux 2> /dev/null)"
		if [[ -v TMUX && -x "$TMUXEXE" ]]; then
			eval "$("$TMUXEXE" show-environment -s)"
			local NUMKEYS=''
			if "${WHENCE_CMD[@]}" ssh-add > /dev/null 2>&1 && "${WHENCE_CMD[@]}" wc > /dev/null 2>&1; then
				NUMKEYS=$( \
					command ssh-add -ql 2> /dev/null | \
					while read -r length fingerprint keycomment; do \
						case "$length" in \
							[0-9][0-9][0-9][0-9]|[0-9][0-9][0-9][0-9][0-9]) \
								printf "%s\n" "$fingerprint"\
								;; \
						esac; \
					done | command wc -l \
				)
			fi
			if [[ -n "$NUMKEYS" ]]; then
				printf "${cY}Reusing${cZ} running ${cB}ssh-agent${cZ} inside tmux (%d keys)\n" "$NUMKEYS"
			else
				printf "${cY}Reusing${cZ} running ${cB}ssh-agent${cZ} inside tmux\n"
			fi
		elif [[ -z "$SSH_AUTH_SOCK" && -x "$SSHAGENT" ]]; then
			printf "${cY}Starting${cZ} ${cB}ssh-agent${cZ} afresh\n"
			eval "$("$SSHAGENT" $SSHAGENTARGS)"
			[[ -n "$SSH_AGENT_PID" && ! -v TMUX ]] && trap "kill $SSH_AGENT_PID" 0
		fi
	fi
	if "${WHENCE_CMD[@]}" stat > /dev/null 2>&1; then
		local LDR="$HOME/.ssh/.load"
		if [[ -O "$LDR" && -G "$LDR" && -s "$LDR" ]]; then
			local PERMS
			PERMS=$(stat -c '%a' "$LDR" 2> /dev/null) || \
				PERMS=$(stat -f '%Lp' "$LDR" 2> /dev/null)
			# Only source when the permissions are known and not group/world writable
			case "$PERMS" in
				''|*[!0-7]*) : ;; # unknown/unparseable -> do not source
				*) (( (8#$PERMS & 8#22) == 0 )) && source "$LDR" ;;
			esac
		fi
	fi
}

if [[ -v BASH_VERSION ]]; then
	declare -ga WHENCE_CMD=(builtin type -P)
elif [[ -v ZSH_VERSION ]]; then
	declare -ga WHENCE_CMD=(builtin whence -p)
fi
if "${WHENCE_CMD[@]}" starship > /dev/null 2>&1; then
	if [[ -v BASH_VERSION ]]; then
		eval "$(starship init bash)"
	elif [[ -v ZSH_VERSION ]]; then
		eval "$(starship init zsh)"
	fi
else
	set_prompt_and_uid
	# The prompt command will only show the current directory and username if the terminal type is "correct"
	case "$TERM" in
		xterm*|rxvt*|screen*|putty*|alacritty*)
			function set_terminal_title
			{
				printf '\033]0;%s%s@%s: %s\007' "${debian_chroot:+($debian_chroot)}" "$USER" "${HOSTNAME:-$HOST}" "$PWD"
			}
			if [[ -v BASH_VERSION ]]; then
				PROMPT_COMMAND=set_terminal_title
			elif [[ -v ZSH_VERSION ]]; then
				precmd_functions+=(set_terminal_title)
			fi
			;;
	esac
fi
add_home_bin
add_cargo_bin
set_remote_timeout
clean_path_var
set_shell_options
# make less more friendly for non-text input files, see lesspipe(1)
"${WHENCE_CMD[@]}" lesspipe > /dev/null 2>&1 && eval "$(lesspipe)"
umask 022
convenience_aliases
load_ssh_agent

if [[ -v BASH_VERSION ]]; then
	# Check for SHELLRCDIR variable ...
	[[ -d "${SHELLRCDIR:-$HOME}" ]] || SHELLRCDIR="$HOME"
	SHELLRCDIR=${SHELLRCDIR:-$HOME}

	# Global Bash completion definitions
	if [[ $- == *i* ]]; then
		for i in /etc/bash_completion /usr/local/share/bash-completion/bash_completion.sh; do
			[[ -f "$i" ]] && source "$i"
		done
	fi

	# Load additional settings
	BASHHOST="${HOSTNAME%%.*}"
	BASHZONE="${HOSTNAME//$BASHHOST/_}"
	BASHSRCDIR="$SHELLRCDIR/.bashrc.d"
	if [[ -d "$BASHSRCDIR" ]]; then
		for f in "$BASHSRCDIR"/*; do
			[[ -f "$f" ]] && source "$f"
		done
		if [[ -d "$BASHSRCDIR/$BASHHOST" ]]; then
			for f in "$BASHSRCDIR/$BASHHOST"/*; do
				[[ -f "$f" ]] && source "$f"
			done
		fi
		if [[ -n "$BASHZONE" ]] && [[ -d "$BASHSRCDIR/$BASHZONE" ]]; then
			for f in "$BASHSRCDIR/$BASHZONE"/*; do
				[[ -f "$f" ]] && source "$f"
			done
		fi
	fi
	unset BASHZONE BASHHOST BASHSRCDIR
fi

# Remove local functions up to here
unset -f set_prompt_and_uid add_home_bin add_cargo_bin set_remote_timeout clean_path_var set_shell_options ls_aliases system_specific_aliases try_source_completions tool_aliases_and_init convenience_aliases load_ssh_agent

type ccd > /dev/null 2>&1 && { unset -f ccd 2> /dev/null; unalias ccd 2> /dev/null; }
# create and cd
function ccd()
{
	if ((${#@} < 2)); then
		mkdir -p -- "$1" && cd -- "$1"
	else
		printf -- "${cY}WARNING${cZ}: ${cW}ccd${cZ} only takes a single argument\n"
	fi
}

# On Windows we return early
[[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || -n "$COMSPEC" ]] && { unset WHENCE_CMD; return; }

if ((SHLVL < 2)); then
	if "${WHENCE_CMD[@]}" tput >/dev/null 2>&1 && colors=$(TERM=xterm-direct tput colors 2>/dev/null) && ((colors > 256)); then
		printf -v truecolor_print " \x1b[38;2;255;100;0m[*]\x1b[0m\n";
	fi
	if "${WHENCE_CMD[@]}" lsb_release > /dev/null 2>&1; then
		if [[ -n $(lsb_release -sc) ]]; then
			printf -- "${cG_}%s %s${cZ} ${cR_}(%s)${cZ}${truecolor_print}\n" "$(lsb_release -si)" "$(lsb_release -sr)" "$(lsb_release -sc)"
		else
			printf -- "${cG_}%s %s${cZ}${truecolor_print}\n" "$(lsb_release -si)" "$(lsb_release -sr)"
		fi
	elif "${WHENCE_CMD[@]}" uname > /dev/null 2>&1; then
		printf -- "${cG_}%s %s${cZ}${truecolor_print}\n" "$(uname -s)" "$(uname -r)"
	else
		printf -- "${cG_}%s %s${cZ}${truecolor_print}\n" "$OSTYPE" "$MACHTYPE"
	fi
	cd
fi
